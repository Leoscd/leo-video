# Copiá este archivo como ".env" (en esta misma carpeta) y pegá tu clave de OpenAI.
# El archivo .env no se sube al repositorio.
OPENAI_API_KEY=

# Modelo que analiza la transcripción (repeticiones, resaltados y zooms).
# gpt-6.1-sol equilibra calidad y costo; gpt-6-luna es más barato; gpt-6-astra es el más capaz.
OPENAI_MODEL=gpt-6.1-sol

# Transcripción: "openai" sube solo el audio comprimido (~0,25 MB por minuto) y tarda segundos.
# "local" usa Whisper.cpp en este equipo: no sube nada, pero es más lento.
LEO_TRANSCRIBE=openai
